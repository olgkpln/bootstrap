#!/usr/bin/env bash
#
# macOS settings, exported from the author's own machine (only values that differ from stock).
# Each write is independent: a failure (e.g. a setting locked by MDM) is reported, not fatal.

failed=()

set_default() {   # set_default <domain> <key> <type> <value>
    local domain="$1" key="$2" type="$3" value="$4"
    if defaults write "$domain" "$key" "-$type" "$value" 2>/dev/null; then
        printf '  ok   %s %s = %s\n' "$domain" "$key" "$value"
    else
        printf '  FAIL %s %s\n' "$domain" "$key" >&2
        failed+=("$domain $key")
    fi
}

echo "General"
set_default NSGlobalDomain AppleInterfaceStyle string Dark          # dark mode
set_default NSGlobalDomain AppleShowAllExtensions bool true         # show all file extensions
set_default NSGlobalDomain AppleMiniaturizeOnDoubleClick bool false # double-click on title bar does not minimize

echo "Dock"
set_default com.apple.dock autohide bool true
set_default com.apple.dock magnification bool true
set_default com.apple.dock wvous-br-corner int 14                   # bottom-right hot corner: Quick Note
set_default com.apple.dock wvous-br-modifier int 0

echo "Finder"
set_default com.apple.finder FXDefaultSearchScope string SCcf       # search the current folder
set_default com.apple.finder ShowExternalHardDrivesOnDesktop bool true
set_default com.apple.finder ShowHardDrivesOnDesktop bool false
set_default com.apple.finder ShowRemovableMediaOnDesktop bool true

echo "Menu bar clock"
set_default com.apple.menuextra.clock ShowAMPM bool true
set_default com.apple.menuextra.clock ShowDate int 0
set_default com.apple.menuextra.clock ShowDayOfWeek bool true

echo "Window manager (Rectangle handles tiling)"
set_default com.apple.WindowManager EnableTilingByEdgeDrag bool false
set_default com.apple.WindowManager EnableTopTilingByEdgeDrag bool false
set_default com.apple.WindowManager EnableTilingOptionAccelerator bool false

for app in Dock Finder SystemUIServer; do
    killall "$app" &>/dev/null || true
done

if (( ${#failed[@]} )); then
    printf '\nSettings that could not be applied (possibly managed by MDM):\n'
    printf '  - %s\n' "${failed[@]}"
fi
exit 0
